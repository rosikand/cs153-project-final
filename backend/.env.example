# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-4-8, most capable).
# Set to claude-sonnet-4-6 for faster/cheaper responses.
PARALLAX_MODEL=claude-opus-4-8

# Optional but recommended: enables the live wildfire-detection feature (NASA FIRMS).
# Get a free key instantly at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it, fire questions gracefully fall back to GIBS smoke/burn-scar imagery.
FIRMS_MAP_KEY=
